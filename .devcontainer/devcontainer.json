// Dev environment for GitHub Codespaces and VS Code Dev Containers.
// No credentials live here or are mounted in: sign in inside the container with
//   gcloud auth application-default login
{
  "name": "Cymbal Cyber SOC",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "UV_VERSION": "0.12.23",
      "NODE_MAJOR": "22",
      "TERRAFORM_VERSION": "1.16.5",
      "GEMINI_CLI_VERSION": "latest"
    }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "64gb"
  },

  "mounts": [
    // Persistent cache for uv and npm downloads, so rebuilds are fast.
    "source=cymbal-devcontainer-cache,target=/home/vscode/.cache,type=volume"
  ],

  "containerEnv": {
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "npm_config_cache": "/home/vscode/.cache/npm",
    "UV_LINK_MODE": "copy",
    "UV_SYSTEM_CERTS": "true",
    "UV_CONCURRENT_DOWNLOADS": "4",
    "UV_HTTP_TIMEOUT": "120",
    "UV_HTTP_RETRIES": "5"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [8501, 8080],
  "portsAttributes": {
    "8501": { "label": "SOC console (Streamlit)", "onAutoForward": "notify" },
    "8080": { "label": "Agent / ADK playground", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "terraform.languageServer.enable": true,
        "jupyter.askForKernelRestart": false,
        "jupyter.interactiveWindow.textEditor.executeSelection": true,
        "notebook.lineNumbers": "on"
      },
      "extensions": [
        "charliermarsh.ruff",
        "github.vscode-pull-request-github",
        "google.google-antigravity",
        "googlecloudtools.datacloud",
        "hashicorp.terraform",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow"
      ]
    }
  },

  "remoteUser": "vscode"
}
